[global]
    monitor = 0
    follow = none
    width = 300
    height = 300
    origin = top-right
    offset = (15, 15)
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4
    icon_corner_radius = 8
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 16
    frame_width = 1
    frame_color = "#3a3a3c"
    gap_size = 10
    separator_color = auto
    sort = yes
    font = "Inter, San Francisco, Helvetica Neue 10"
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_posix_regex = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 12
    corners = all
    ignore_dbusclose = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1c1c1ee6"
    foreground = "#8e8e93"
    frame_color = "#3a3a3c"
    timeout = 10

[urgency_normal]
    background = "#1c1c1ee6"
    foreground = "#ffffff"
    frame_color = "#3a3a3c"
    timeout = 10

[urgency_critical]
    background = "#1c1c1ee6"
    foreground = "#ff453a"
    frame_color = "#ff453a"
    timeout = 0
