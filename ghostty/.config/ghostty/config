font-size = 13
font-family = JetBrainsMono Nerd Font
font-feature = calt
font-feature = liga
font-thicken = false

cursor-style = underline
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000

window-padding-x = 6 
window-padding-y = 6
window-padding-balance = true
window-decoration = true
window-inherit-working-directory = true
window-save-state = always

# override Tahoe-Dark theme's dark window padding (the black border ring),
# keep its rounded corners. see glass.css for details.
gtk-custom-css = glass.css

# frosted-glass look: dark base for text contrast + partial transparency so
# the blurred wallpaper still shows. nudge opacity 0.5-0.75 (higher = readable,
# lower = more glass). darker `background` = more contrast for light text.
background = #11111b
background-opacity = 0.6
background-blur = 8
# theme = Catppuccin Mocha
gtk-titlebar = false
foreground = #cdd6f4
cursor-color = #f5c2e7
selection-background = #181825
selection-foreground = #cdd6f4

palette = 0=#181825
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
